CONFIGURAR .SH
permisos: 
mover el archivo  inicio.sh al escritorio fuera de la carpeta publi editar el archivo con:

	sudo nano inicio.sh

Reemplazar el contenido por esto
#!/bin/bash

# Esperar a que haya conexión a internet
while ! ping -c 1 8.8.8.8 &>/dev/null; do
    echo "Esperando conexión a Internet..."
    sleep 5
done

# Esperar a que el monitor esté encendido
export DISPLAY=:0
while ! xrandr | grep " connected " &>/dev/null; do
    echo "Esperando a que el monitor esté encendido..."
    sleep 5
done

cd /home/$USER/Desktop/publi/ || exit
. venv/bin/activate || exit
echo "Iniciando presentación..."
python3 slideshw.py


y aplicar permisos
	sudo chmod 777 inicio.sh
Configurar servicio publicidad
Ejecutar:
sudo nano /etc/systemd/system/inicio-publicidad.service

Copiar y pegar 
		[Unit]
Description=Iniciar publicidad
After=multi-user.target network-online.target display-manager.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /home/publicidad/Desktop/inicio.sh
User=publicidad
WorkingDirectory=/home/publicidad/Desktop/publi
StandardOutput=append:/home/publicidad/Desktop/inicio.log
StandardError=append:/home/publicidad/Desktop/inicio.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

Ejecutar
sudo systemctl daemon-reload
sudo systemctl enable publicidad.service
sudo systemctl restart publicidad.service







